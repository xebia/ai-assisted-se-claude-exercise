node_modules/
dist/

# Generated by `specify init` during preparation. Contents drift between Spec
# Kit versions, so they are not committed — with one exception: the constitution
# is committed at Spec Kit's own path, because it is authored, not generated.
# `specify init --force` overwrites it, so preparation restores it afterwards
# with `git checkout --`.
.specify/*
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md

# Also generated by `specify init --integration claude`: the speckit-* skills.
.claude/
