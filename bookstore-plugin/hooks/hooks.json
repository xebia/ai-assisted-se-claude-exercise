{
  "description": "Two hooks from session 4: the secret guard blocks a prompt that contains an ACME API key; the changelog gate refuses to let Claude finish while commits are missing from CHANGELOG.md.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-secrets.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-changelog.py\""
          }
        ]
      }
    ]
  }
}
